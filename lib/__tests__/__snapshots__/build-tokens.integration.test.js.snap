  --pgn-spacing-input-btn-padding-y: 0.5625rem;
  --pgn-color-gray-100: #F2F2F2FF; /** Gray color of level 100. */
  --pgn-color-primary-base: #00262BFF; /** Basic primary color. */
  --pgn-spacing-form-input-padding-y-base: 0.5625rem;
  --pgn-color-action-default-gray-100: #D9D9D9FF;
  --pgn-color-action-default-primary-base: #000000FF;
}
",
}
`;
